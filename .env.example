# Mailgun credentials — required when PORT /api/contact and /api/pageview
# send real emails (wired in phase v0.1-backend). Not needed for the
# scaffold phase where both routes return 204 No Content.
#
# Per PORT-API-1: server loads these via std::env at handler call time.
# No dotenv crate — set these in your shell or deployment environment.

# Mailgun API key (Basic auth password for the Messages API)
MAILGUN_API_KEY=

# Mailgun sending domain (e.g. mg.zachary-ernst.dev)
MAILGUN_DOMAIN=

# Destination address for Zach's notification emails
NOTIFY_TO_EMAIL=
